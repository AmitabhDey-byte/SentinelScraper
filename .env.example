# Bright Data Scraper Studio
BRIGHTDATA_API_TOKEN=replace_me
# The CLI also accepts this alias; use the same value in CI if required.
BRIGHTDATA_API_KEY=replace_me

# Gemini narration
GEMINI_API_KEY=replace_me
