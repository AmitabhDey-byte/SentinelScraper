# Bright Data Scraper Studio
BRIGHTDATA_API_TOKEN=replace_me
# The CLI also accepts this alias; use the same value in CI if required.
BRIGHTDATA_API_KEY=replace_me

# Gemini narration
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash-lite

# Application
# Local: sqlite:///./backend/sentinelscrape.db
# Neon: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./backend/sentinelscrape.db
APP_ENV=development
# Required only for production mutation endpoints. Local development allows the built-in observer.
OPERATIONS_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMPETITOR_SOURCES_JSON=[]
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
API_HOST=127.0.0.1
API_PORT=8000
SCHEDULER_INTERVAL_MINUTES=30
